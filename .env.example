NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical public URL (PayFast ITN notify_url). Use https://www.venturo.co.za in production.
NEXT_PUBLIC_SITE_URL=https://www.venturo.co.za
# Also add these Redirect URLs in Supabase Auth → URL Configuration:
#   http://127.0.0.1:3000/auth/callback
#   https://www.venturo.co.za/auth/callback
# Enable Google / Apple / Facebook under Auth → Providers.

# RevenueCat project id is not the secret key. Paid checks need sk_ from API keys.
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=subscription_monthly_1

# Store listing URLs (must include app id / details path — not the store homepage)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Server-only. Needed to invite staff from Control Room & PayFast ITN fulfill.
SUPABASE_SERVICE_ROLE_KEY=

# PayFast — event tickets + monthly membership (sandbox until merchant approved)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# sandbox | live — set live on Vercel Production after PayFast approval
PAYFAST_ENV=sandbox
# Recurring Billing must be enabled on the PayFast merchant for memberships.
# ITN URL to paste in PayFast: {NEXT_PUBLIC_SITE_URL}/api/payfast/itn
