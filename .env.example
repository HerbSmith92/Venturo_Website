NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical public URL (Paystack webhook & absolute links). Use https://www.venturo.co.za in production.
NEXT_PUBLIC_SITE_URL=https://www.venturo.co.za
# Also add these Redirect URLs in Supabase Auth → URL Configuration:
#   http://127.0.0.1:3000/auth/callback
#   https://www.venturo.co.za/auth/callback
# Enable Google / Apple / Facebook under Auth → Providers.

# RevenueCat — App Store / Play Store payments write member_access via webhook.
# Paid on the website & app is member_access.subscribed, not a live RevenueCat call.
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=subscription_monthly_1
# Same value as Authorization in the RevenueCat dashboard webhook.
REVENUECAT_WEBHOOK_AUTH=
# Set true only if sandbox purchases should grant access in this environment.
REVENUECAT_WEBHOOK_ALLOW_SANDBOX=

# Store listing URLs (must include app id / details path — not the store homepage)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# App Store Connect — Control Room iOS download totals (Team key with Sales reports)
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_VENDOR_NUMBER=
# PKCS8 .p8 contents. Use \n for newlines.
APP_STORE_CONNECT_PRIVATE_KEY=

# Play Console — Control Room Android install totals (Download reports Cloud Storage)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_REPORTS_BUCKET=
# Full service-account JSON. Needs storage.objects.get on the Play reports bucket.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Server-only. Needed to invite staff from Control Room & Paystack webhook fulfill.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — event tickets & monthly membership on the website. The app can still use the stores.
# Dashboard → Settings → API Keys & Webhooks. Use the test secret while building.
PAYSTACK_SECRET_KEY=
# Optional. If empty, the first membership checkout creates a ZAR monthly plan named "Venturo Membership".
PAYSTACK_PLAN_CODE=
# Webhook URL to paste in Paystack (test & live are separate): {NEXT_PUBLIC_SITE_URL}/api/paystack/webhook
# Live cutover is a key swap: replace PAYSTACK_SECRET_KEY with the live secret. Do not commit either key.
