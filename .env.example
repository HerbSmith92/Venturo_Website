NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat project id is not the secret key. Paid checks need sk_ from API keys.
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=subscription_monthly_1

# Optional store links shown on the Paid plan
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store

# Server-only. Needed to invite staff from Control Room.
SUPABASE_SERVICE_ROLE_KEY=
